# 2026-09-02 12:17:40.318501
+Dans app/services/telegram_bot.py, remplace la fonction _store_checkin par celle-ci qui correspond exactement au schéma Supabase :
+
+async def _store_checkin(athlete_id: str, checkin: dict, score: float, label: str, source: str = "text"):
+    payload = {
+        "athlete_id": athlete_id,
+        "sleep_score": checkin.get("sleep_score"),
+        "energy_score": checkin.get("energy_score"),
+        "stress_score": checkin.get("stress_score"),
+        "pain_score": checkin.get("pain_score"),
+        "pain_location": checkin.get("pain_location"),
+        "readiness_score": score,
+        "readiness_status": label,
+        "raw_text": checkin.get("raw_text", "")
+    }
+    logger.info(f"Insertion check-in Supabase pour athlete_id={athlete_id} : {payload}")
+    try:
+        response = _database().table("checkins").insert(payload).execute()
+        return response
+    except Exception as e:
+        logger.error(f"Erreur Supabase lors du checkin : {e}", exc_info=True)
+        raise RuntimeError("Échec de l'enregistrement du check-in") from e

